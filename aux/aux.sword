package aux

import "std/io"
import "std/os"
import "std/strings"

func Sep() string {
    return "\n=================\n"
}


func Print(gen []u8, dim_y uint, dim_x uint, per_bit u64) !void {
    try io.Printf("x: {} y: {} b: {}\n", dim_x, dim_y, per_bit)

    for i in 0..u64(dim_y){
        for j in 0..u64(dim_x)  {
            byte_index := i * dim_x + j
            index := byte_index / per_bit
            offset := byte_index % per_bit

            curr := gen[index]

            is_alive := (curr & (1 << u8(offset))) > 0

            if is_alive {
                try io.Print("1 ")
            } else {
                try io.Print("0 ")
            }
        }
        try io.Print("\n")
    }
}


/* Sword does not implement yet a threads function substitute it when it does, for now run the env.sh */
func Threads() u64 {
    var_threads := os.EnvOr("THREADS", "1")
    return strings.ParseU64(var_threads) catch 1
}


