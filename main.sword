import "std/mem"
import "std/io"

import "aux"

const G = 10; // Generations
const DimX = 5
const DimY = 4

const SizeX = DimX * 8 // size of u8   DimX * (sizeof[u8]() * 8)
const SizeY = DimY * 8

const SizeBuf = DimY * DimX // size of allocated buffer

func Process(mut next_gen mem.Allocator, mut gen []u8) void {
    aux.Print(gen, DimY, DimX) catch {}
}

func main() !void {

    try io.Printf("{}Board Size:\nsize x: {} ({} u8)\nsize y: {} ({} u8)\nTotal Size: {} ({} u8){}", aux.Sep(), SizeX, DimX, SizeY, DimY, SizeBuf, SizeX * SizeY, aux.Sep())

    mut gen_even := [SizeBuf]u8{}
    mut gen_odd := [SizeBuf]u8{}

    mut even_arn := mem.NewArena(gen_even[..])
    mut odd_arn := mem.NewArena(gen_odd[..])


    /* Test input */

    gen_even[1] = 0b00001000

    for i in 0..G {
        try io.Printf("{} {}th Generation Begins {}", aux.Sep(), i, aux.Sep())

        if i % 2 == 0 {
            Process(&odd_arn, gen_even[..])
            even_arn.Reset()
        } else {
            Process(&even_arn, gen_odd[..])
            odd_arn.Reset()
        }
    }
}