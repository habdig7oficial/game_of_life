import "std/mem"
import "std/io"

import "aux"
import "lib"

const G = 10; // Generations
const DimX = 2
const DimY = 1

const u8 = 8
const SizeX = DimX * u8 // size of u8   DimX * (sizeof[u8]() * 8)
const SizeY = DimY * u8

const SizeBuf = DimY * DimX * u8 // size of allocated buffer
const DimBuf = SizeY * SizeX

func Process(mut next_gen []u8, mut gen []u8) !void {
    aux.Print(gen, SizeY, SizeX, u8) catch {}

    th := aux.Threads() 

    lib.Next(gen, next_gen, SizeY, SizeX, u8) catch {}

    io.Printf("{} ", SizeBuf) catch {}
    io.Printf("{}\n", th) catch {}
}

func main() !void {
    try io.Printf("{}Board Size:\n", aux.Sep())
    try io.Printf("size x: {} ({} u8)\nsize y: {} ({} u8)\n",  SizeX, DimX, SizeY, DimY)
    try io.Printf("Total Size: {} ({} u8){}", DimBuf, SizeBuf, aux.Sep())

    mut gen_even := [SizeBuf]u8{}
    mut gen_odd := [SizeBuf]u8{}

    mut even_arn := mem.NewArena(gen_even[..])
    //mut odd_arn := mem.NewArena(gen_odd[..])

    // basic oscilator remove later
    gen_even[2] = 8
    gen_even[4] = 8
    gen_even[6] = 8

    gen_even[7] = 100
    gen_even[9] = 100

    for i in 0..G {
        try io.Printf("{} {}th Generation Begins {}", aux.Sep(), i, aux.Sep())

        if i % 2 == 0 {
            try Process(gen_odd[..], gen_even[..])
            //even_arn.Reset()
        } else {
            try Process(gen_even[..], gen_odd[..])
            //odd_arn.Reset()
        }
        break
    }
}